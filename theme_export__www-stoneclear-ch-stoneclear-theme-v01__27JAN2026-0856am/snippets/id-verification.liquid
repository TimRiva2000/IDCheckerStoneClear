{%- if settings.id_verification_enable and cart.item_count > 0 -%}
  <div
    class="idv-block cart-block element--has-border--body element--border-radius margin-top--regular"
    data-idv-block
    data-idv-upload-url="{{ settings.id_verification_endpoint }}"
  >
    <div class="cart-block__content">
      <p class="text-size--small text-color--opacity idv-block__help">
        Der Kauf unserer Produkte ist gesetzlich nur ab 18 Jahren erlaubt. Bitte lade ein Ausweisfoto zur Verifikation hoch, danach wird deine Bestellung freigegeben.
      </p>
      <div class="idv-block__controls">
        <input
          id="idUpload"
          type="file"
          accept="image/*"
          class="idv-block__file"
          form="cart"
          data-idv-file
        >
        <input
          type="hidden"
          name="properties[ID Upload]"
          form="cart"
          data-idv-url
          value=""
        >
        <label class="idv-block__button button button--regular button--outline" for="idUpload">
          <span class="button__text">ID Hochladen</span>
        </label>
        <span class="idv-block__status idv-block__status--loading" data-idv-loading aria-live="polite">Hochladen...</span>
        <span class="idv-block__success" data-idv-success aria-live="polite">Erfolgreich!</span>
        <span class="idv-block__status idv-block__status--error" data-idv-error aria-live="polite"></span>
      </div>
    </div>
  </div>
{%- endif -%}
